# ============================================================
# All-in-One - Environment Configuration
# ============================================================

# -----------------
# App
# -----------------
APP_NAME=all-in-one
DEBUG=true
ENVIRONMENT=development

# -----------------
# Logging
# -----------------
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# 开发环境建议使用 DEBUG，生产环境建议使用 INFO
LOG_LEVEL=INFO
# 是否输出到控制台 (true/false，默认 true)
LOG_CONSOLE=true
# 是否写入日志文件 (true/false，默认 false)
LOG_FILE=false
# 单个日志文件最大大小（字节），默认 100MB
# LOG_FILE_MAX_BYTES=104857600
# 最多保留的滚动备份文件数量
# LOG_FILE_BACKUP_COUNT=100
# 日志根目录（LOG_FILE=true 时必填，按日期自动创建子目录）
# LOG_DIR=./logs

# -----------------
# Server
# -----------------
HOST=0.0.0.0
PORT=8000
# CORS (comma-separated list or JSON array)
CORS_ORIGINS=["*"]

# -----------------
# Database
# -----------------
# 容器内访问宿主机使用 172.17.0.1（Mac/Windows）
# Linux 宿主机使用：172.17.0.1 或实际 IP
DATABASE_URL=postgresql+asyncpg://<user>:<pass>@172.17.0.1:5432/app-dev-v2
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# -----------------
# Redis
# -----------------
REDIS_URL=redis://<user>:<pass>@172.17.0.1:6379/0
REDIS_MAX_CONNECTIONS=50

# -----------------
# Celery（必须与 worker-in-one 一致）
# -----------------
# services_common / workers_common 默认均为 db1/db2
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BROKER_RESULT_BACKEND=redis://localhost:6379/2
