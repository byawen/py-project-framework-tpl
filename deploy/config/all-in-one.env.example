# ============================================================
# All-in-One - Production Environment Configuration
# ============================================================

# ------------------------------
# App
# ------------------------------
APP_NAME=all-in-one
DEBUG=false
ENVIRONMENT=production

# ------------------------------
# Logging
# ------------------------------
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# 开发环境建议使用 DEBUG，生产环境建议使用 INFO
LOG_LEVEL=INFO

# ------------------------------
# Server
# ------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------
# CORS (comma-separated list or JSON array)
# ------------------------------
CORS_ORIGINS=["*"]

# ------------------------------
# Database
# ------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/zeroone
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ------------------------------
# Redis
# ------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ------------------------------
# Celery（必须与 worker-in-one 使用同一 broker/result backend）
# ------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_BROKER_RESULT_BACKEND=redis://redis:6379/2

# ============================================================
# PingPong Service
# ============================================================
