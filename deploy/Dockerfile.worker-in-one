# Worker-in-One 镜像
# 将所有 Celery Worker（pingpong-worker / content-ops-worker 等）聚合在单一进程中运行
ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/workspace \
    TZ=Asia/Shanghai

# 安装 uv（快速的 Python 包管理器）
RUN pip install --no-cache-dir uv -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 设置工作目录
WORKDIR /workspace

# 复制项目根目录的 pyproject.toml（用于 workspace 依赖解析）
COPY pyproject.toml /workspace/pyproject.toml

# 复制 worker 相关代码（按依赖顺序）
COPY workers/common /workspace/workers/common
COPY workers/pingpong-worker /workspace/workers/pingpong-worker

# 复制 worker-in-one 应用
COPY worker-in-one /workspace/worker-in-one

# 按依赖顺序安装（先安装基础依赖，再安装依赖它们的 worker）
# 1. workers-common（所有 worker 的基础依赖）
RUN uv pip install --system -e ./workers/common -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 2. 各 worker（并行无依赖，分步安装以减少内存使用）
RUN uv pip install --system -e ./workers/pingpong-worker -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 3. 最后安装 worker-in-one（依赖上面所有 worker）
RUN uv pip install --system -e ./worker-in-one -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 创建必要的目录（视频缓存放在 /workspace 下，确保 appuser 有写入权限且可挂载卷）
RUN mkdir -p /workspace/worker-in-one/logs

# 创建非root用户并设置权限
RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /workspace

# 切换到非root用户
USER appuser

# 切换到 worker-in-one 目录
WORKDIR /workspace/worker-in-one

# 健康检查（worker 进程无 HTTP 端口，检查进程是否存活）
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep -f "worker_in_one" > /dev/null || exit 1

# 默认命令 - 启动 Worker-in-One 聚合进程
CMD ["python", "-m", "worker_in_one.main"]
