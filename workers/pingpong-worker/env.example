# ============================================================
# pingpong Worker - Environment Configuration
# ============================================================

# -----------------------
# App
# -----------------------
APP_NAME=pingpong-worker
DEBUG=true
ENVIRONMENT=development

# -----------------------
# Logging
# -----------------------
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=false
# LOG_FILE_MAX_BYTES=104857600
# LOG_FILE_BACKUP_COUNT=100
# LOG_DIR=./logs

# -----------------------
# Broker (消息队列)
# -----------------------
# Broker 类型: celery (后续可扩展: rabbitmq, pubsub, kafka 等)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BROKER_RESULT_BACKEND=redis://localhost:6379/2

# Celery 并发配置
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_LOGLEVEL=info
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=true

# -----------------------
# Database
# -----------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pingpong-db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# -----------------------
# Redis
# -----------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# -----------------------
# External Services
# -----------------------
OTHER_SERVICE_URL="http://localhost:8001"