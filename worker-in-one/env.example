# ============================================================
# Worker-in-One - Environment Configuration
# ============================================================

# ============================================================
# App
# ============================================================
APP_NAME=worker-in-one
DEBUG=true
ENVIRONMENT=development

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_MAX_BYTES=104857600
LOG_FILE_BACKUP_COUNT=100
LOG_DIR=./logs

# ============================================================
# Broker (消息队列) — 所有 worker 共用
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BROKER_RESULT_BACKEND=redis://localhost:6379/2

# Celery 并发配置
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_LOGLEVEL=info
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=true

# Per-queue 并发覆盖（worker-in-one 模式下每个队列独立 WorkController 线程）
# JSON dict: {"queue_name": concurrency}，未列出的队列回退到 CELERY_WORKER_CONCURRENCY
CELERY_QUEUE_CONCURRENCY={"pingpong":2}

# OOM 防护：pool worker 执行 N 个任务后回收，超内存 KB 后回收
# worker_lost 时 reject 重入队，避免任务丢失
# pool worker 子进程执行 N 个任务后自动回收 fork 新进程，防止内存泄漏累积（0=禁用）
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
# pool worker RSS 超过此值（KB）后，当前任务完成后回收（0=禁用）
CELERY_WORKER_MAX_MEMORY_PER_CHILD=2000000
# worker 被 SIGKILL/OOM 杀死时，reject 消息使其重回队列而非标记失败（需 task_acks_late=true）
CELERY_TASK_REJECT_ON_WORKER_LOST=true

CELERY_USE_THREADS_POOL=true
# IO 队列切 threads（线程级 loop + thread-local 连接池，省进程）；CPU 密集队列保持 prefork
CELERY_QUEUE_POOL={"pingpong.io":"threads","pingpong.cpu":"prefork"}

# ============================================================
# Database — 所有 worker 共用
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app-db-dev
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ============================================================
# Redis — 所有 worker 共用
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ============================================================
# Worker-in-One 专用
# ============================================================
WORKER_IN_ONE_SHARE_DB=true
WORKER_IN_ONE_SHARE_REDIS=true
