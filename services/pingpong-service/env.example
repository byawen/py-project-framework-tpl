# ============================================================
# pingpong Service - Environment Configuration
# ============================================================

# -----------------------
# App
# -----------------------
APP_NAME=pingpong-service
DEBUG=true
ENVIRONMENT=development

# -----------------------
# Logging
# -----------------------
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=false
# 单个日志文件最大大小（字节），默认 100MB
# LOG_FILE_MAX_BYTES=104857600
# 最多保留的滚动备份文件数量
# LOG_FILE_BACKUP_COUNT=100
# LOG_DIR=./logs

# -----------------------
# Server
# -----------------------
HOST=0.0.0.0
PORT=8001
# CORS (comma-separated list)
CORS_ORIGINS=*

# -----------------------
# Database
# -----------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pingpong-db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# -----------------------
# Redis
# -----------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# -----------------------
# Rate limiting
# -----------------------
RATE_LIMIT_PER_MINUTE=60

# -----------------------
# External Services
# -----------------------
OTHER_SERVICE_URL="http://localhost:8001"